# Xcode build products and derived state
build/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated project — project.yml is the source of truth, the project is not
*.xcodeproj/
*.xcworkspace/

# User-specific Xcode state
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.perspectivev3
*.mode1v3
*.mode2v3
*.pbxuser
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Simulator / instruments output
*.xcresult/
*.xctestrun

# macOS and editor noise
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Anything that must never enter the app bundle — except the bundled
# EdgeSAM artifacts under the dedicated model-assets path, which the app
# genuinely needs at runtime. See docs/DECISIONS.md, "EdgeSAM and the Core
# ML exception (v0.4)", and docs/EDGESAM_PROVENANCE.md. This mirrors the
# same narrow, path-scoped exception already carved into
# scripts/static_audit.py — everywhere else, these patterns are unchanged.
*.mlmodel
*.mlmodelc
*.mlpackage/
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
!Sources/Resources/Models/**
