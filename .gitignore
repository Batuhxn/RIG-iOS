# Xcode build products and derived state
build/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated project — project.yml is the source of truth, the project is not
*.xcodeproj/
*.xcworkspace/

# User-specific Xcode state
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.perspectivev3
*.mode1v3
*.mode2v3
*.pbxuser
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Simulator / instruments output
*.xcresult/
*.xctestrun

# macOS and editor noise
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Model artefacts never enter git. The single exception to "no bundled model"
# (Resources/Models/RIGGarmentEncoder.mlmodel) is fetched against a pinned
# SHA-256 — see docs/DECISIONS.md, "One garment encoder, delivered outside git".
# The same patterns are enforced by scripts/static_audit.py.
*.mlmodel
*.mlmodelc
*.mlpackage/
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors

# Distribution credentials belong in secure storage.
*.p12
*.p8
*.mobileprovision
*.keychain
*.keychain-db
AuthKey_*
